---
import {
  buildNavPages,
  getNormalizedBase,
  normalizePath,
  stripBase,
} from "../util/contentNavigation.js";

const base = import.meta.env.BASE_URL ?? import.meta.env.base;
const normalizedBase = getNormalizedBase(base);
const currentPath = normalizePath(Astro.url.pathname);
const currentRoutePath = normalizePath(
  stripBase(currentPath, normalizedBase) || "/",
);
const markdownModules = import.meta.glob("/src/pages/**/*.md", { eager: true });
const markdownPages = buildNavPages(markdownModules, normalizedBase);
const topLevelPages = markdownPages
  .filter(
    (page) =>
      (page.parentPath === null || page.parentPath === "/") &&
      page.routePath !== "/",
  )
  .sort((a, b) => a.order - b.order || a.label.localeCompare(b.label));

const isActive = (routePath) =>
  routePath === "/"
    ? currentRoutePath === "/"
    : currentRoutePath === routePath ||
      currentRoutePath.startsWith(`${routePath}/`);
---

<nav class="lap-primary-nav" aria-label="Primary">
  <div class="govuk-width-container">
    <ul class="lap-primary-nav__list">
      {
        topLevelPages.map((page) => (
          <li
            class={
              "lap-primary-nav__item" +
              (isActive(page.routePath)
                ? " lap-primary-nav__item--active"
                : "")
            }
          >
            <a
              class="lap-primary-nav__link"
              href={page.linkHref}
              aria-current={isActive(page.routePath) ? "page" : undefined}
            >
              {page.navLabel ?? page.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style lang="scss">
  .lap-primary-nav {
    background-color: var(--govuk-brand-colour);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .lap-primary-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lap-primary-nav__item {
    margin: 0;
  }

  .lap-primary-nav__link {
    display: inline-block;
    padding: 12px 15px;
    color: #ffffff;
    font-family: Arial, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    border-bottom: 4px solid transparent;
  }

  .lap-primary-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lap-primary-nav__link:focus {
    color: #0b0c0c;
    background-color: #ffdd00;
    box-shadow: 0 -2px #ffdd00, 0 4px #0b0c0c;
    text-decoration: none;
    outline: 3px solid transparent;
  }

  .lap-primary-nav__item--active .lap-primary-nav__link {
    border-bottom-color: #ffffff;
  }

  .lap-primary-nav__item--active .lap-primary-nav__link:focus {
    border-bottom-color: #0b0c0c;
  }
</style>
