---
import { normalizePath } from "../util/contentNavigation.js";

const { page, currentPath } = Astro.props;
const isCurrentPage = currentPath === normalizePath(page.href);
---

<a
  class={`govuk-link govuk-link--no-visited-state${isCurrentPage ? " govuk-!-font-weight-bold" : ""}`}
  href={page.linkHref}
  aria-current={isCurrentPage ? "page" : undefined}
>
  {page.label}
</a>
