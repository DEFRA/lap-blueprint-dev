---
import NavGroupList from "./NavGroupList.astro";
import {
  buildChildPagesByParent,
  buildNavPages,
  getNormalizedBase,
  normalizePath,
  stripBase,
} from "../util/contentNavigation.js";

const base = import.meta.env.BASE_URL ?? import.meta.env.base;
const normalizedBase = getNormalizedBase(base);
const currentPath = normalizePath(Astro.url.pathname);
const currentRoutePath = normalizePath(
  stripBase(currentPath, normalizedBase) || "/",
);
const markdownModules = import.meta.glob("/src/pages/**/*.md", {
  eager: true,
});
const markdownPages = buildNavPages(markdownModules, normalizedBase);
const topLevelPages = markdownPages.filter(
  (page) => page.parentPath === null || page.parentPath === "/",
);
const childPagesByParentPath = buildChildPagesByParent(markdownPages);
---

<nav class="lap-side-navigation" aria-label="Markdown pages">
  {
    topLevelPages.length > 0 ? (
      <ul class="govuk-list lap-side-navigation__list">
        <NavGroupList
          pages={topLevelPages}
          currentPath={currentPath}
          currentRoutePath={currentRoutePath}
          childPagesByParentPath={childPagesByParentPath}
        />
      </ul>
    ) : (
      <p class="govuk-body-s govuk-!-margin-bottom-0">
        No markdown pages found in this folder.
      </p>
    )
  }
</nav>

<style lang="scss">
  .lap-side-navigation {
    padding-left: 0;
  }

  .lap-side-navigation__dash {
    display: inline-block;
    margin-right: 8px;
    width: 10px;
  }
</style>
