---
import {
  buildBreadcrumbs,
  buildLabelsByRoute,
  getNormalizedBase,
  normalizePath,
} from "../util/contentNavigation.js";

const base = import.meta.env.BASE_URL ?? import.meta.env.base;
const normalizedBase = getNormalizedBase(base);

const markdownModules = import.meta.glob("/src/pages/**/*.md", {
  eager: true,
});
const labelsByRoute = buildLabelsByRoute(markdownModules, normalizedBase);
const currentPath = normalizePath(Astro.url.pathname);
const breadcrumbs = buildBreadcrumbs(
  currentPath,
  labelsByRoute,
  normalizedBase,
);
---

{
  breadcrumbs.length > 0 && (
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
      <ol class="govuk-breadcrumbs__list">
        {breadcrumbs.map((crumb) =>
          crumb.isLast ? (
            <li class="govuk-breadcrumbs__list-item" aria-current="page">
              {crumb.label}
            </li>
          ) : (
            <li class="govuk-breadcrumbs__list-item">
              <a class="govuk-breadcrumbs__link" href={crumb.href}>
                {crumb.label}
              </a>
            </li>
          ),
        )}
      </ol>
    </nav>
  )
}
